# Maintainer: HougeLangley <HougeLangley@users.noreply.github.com>
# Arch Linux 打包脚本（aarch64 / x86_64 通用）
pkgname=hov-qt
pkgver=1.1.0
pkgrel=1
pkgdesc="聚合视频 Hyper Online Video —— YouTube/Bilibili/网易云/QQ音乐 播放器（Qt6 桌面版）"
arch=('aarch64' 'x86_64')
url="https://github.com/HougeLangley/HyperOnlineVideo"
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-declarative' 'mpv' 'ffmpeg' 'yt-dlp')
makedepends=('cmake' 'ninja' 'pkgconf')
optdepends=('qt6-webengine: App 内登录窗口（不装则改为手动放置 cookie 文件）')
options=('!strip')
# 正式发布（远端已有 v$pkgver tag）时启用下面这行网络源：
# source=("$pkgname-$pkgver.tar.gz::https://github.com/HougeLangley/HyperOnlineVideo/archive/refs/tags/v$pkgver.tar.gz")
# sha256sums=('SKIP')   # 发布正式版时填入真实校验值
#
# 本地源码模式：直接从仓库工作区构建（适用于尚未推送的开发阶段）
source=("HyperOnlineVideo::git+file:///home/houge/HyperOnlineVideo/.git")
sha256sums=('SKIP')
# 本地模式下的 srcdir 名固定为 HyperOnlineVideo（git clone 目标名）

build() {
  cd "$srcdir/HyperOnlineVideo/desktop"
  cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  cd "$srcdir/HyperOnlineVideo/desktop"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# 说明：
# 1) 桌面版目前依赖系统 libmpv（Arch 的 mpv 包同时提供 libmpv 与头文件）
# 2) 若日后接入 KMP 共享核心，需把 hovcore 的产物一并打包（见 packaging/README.md）
